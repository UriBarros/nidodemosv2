# Supabase — client-side (anon key é safe expor)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# API gtrifood — público (apenas hostname). Em prod, Next.js chama via fetch.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Em prod (dentro do container web), fala com api via DNS interno do Swarm:
# API_INTERNAL_URL=http://gtrifood_api:8000
