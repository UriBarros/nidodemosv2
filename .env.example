# =============================================================================
# gtrifood — variáveis de ambiente
# Copia este arquivo pra .env e preenche os valores. .env NUNCA vai pro git.
# =============================================================================

# --- iFood Developer API (app Centralizado de TESTE) ---
# Pega no portal: developer.ifood.com.br → Meus aplicativos → seu app → Credenciais
IFOOD_CLIENT_ID=cole-seu-client-id-aqui
IFOOD_CLIENT_SECRET=cole-seu-client-secret-aqui

# Ambiente da API iFood. Para TEST usa o mesmo base URL — eles diferenciam pela credencial.
IFOOD_API_BASE_URL=https://merchant-api.ifood.com.br
IFOOD_AUTH_URL=https://merchant-api.ifood.com.br/authentication/v1.0/oauth/token

# --- Supabase ---
# Pega no painel Supabase: Project Settings → API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Connection string Postgres (Project Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres:senha@db.seu-projeto.supabase.co:5432/postgres

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
# Chave Fernet pra encriptar tokens iFood no banco. Gera com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=cole-fernet-key-aqui

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Streamlit dashboard ---
DASHBOARD_PORT=8501
API_BASE_URL=http://localhost:8000
